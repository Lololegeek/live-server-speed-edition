{
  "name": "live-server-speed-edition",
  "displayName": "Live Server Speed Edition",
  "description": "Preview your local web project inside a VS Code WebView or Default Browser with live reload.",
  "version": "1.3.0",
  "keywords": [
    "live server",
    "live preview",
    "reload",
    "auto reload",
    "hot reload",
    "local server",
    "web development",
    "frontend",
    "html",
    "css",
    "javascript",
    "typescript",
    "extension",
    "vscode",
    "development",
    "localhost",
    "http server",
    "http",
    "https",
    "localhost server",
    "live",
    "preview",
    "reloads",
    "auto",
    "hot",
    "local",
    "server",
    "Microsoft",
    "WebView",
    "speed",
    "web",
    "Live Server",
    "fast",
    "productivity",
    "developer tools",
    "Christmas"
  ],
  "publisher": "Lololegeek",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lololegeek/live-server-speed-edition"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fast-http-server.toggleServer",
        "title": "Start Fast HTTP Server"
      },
      {
        "command": "fast-http-server.relaunchLast",
        "title": "Relaunch Live Server with Last Parameters"
      },
      {
        "command": "fast-http-server.setShortcut",
        "title": "Set Relaunch Shortcut"
      },
      {
        "command": "fast-http-server.openKeybindings",
        "title": "Open Keyboard Shortcuts for Live Server Speed Edition"
      },
      {
        "command": "fast-http-server.openSettings",
        "title": "Open Extension Settings"
      },
      {
        "command": "fast-http-server.restartServer",
        "title": "Restart Live Server"
      },
      {
        "command": "fast-http-server.showLogs",
        "title": "Show Live Server Logs"
      },
      {
        "command": "fast-http-server.detectProject",
        "title": "Detect Web Project"
      },
      {
        "command": "fast-http-server.goBack",
        "title": "Go Back (Setup)"
      },
      {
        "command": "fast-http-server.openHtmlWithLastParams",
        "title": "%openHtmlWithLastParams%"
      },
      {
        "command": "fast-http-server.openHtmlWithNewParams",
        "title": "%openHtmlWithNewParams%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fast-http-server.openHtmlWithLastParams",
          "when": "resourceExtname == .html",
          "group": "2_workspace@1"
        },
        {
          "command": "fast-http-server.openHtmlWithNewParams",
          "when": "resourceExtname == .html",
          "group": "2_workspace@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fast-http-server.toggleServer",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Live Server Speed Edition",
      "properties": {
        "liveServerSpeed.language": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "es",
            "de"
          ],
          "default": "en",
          "description": "%liveServerSpeed.language.description%"
        },
        "liveServerSpeed.debounceTime": {
          "type": "number",
          "default": 50,
          "minimum": 50,
          "maximum": 1000,
          "description": "%liveServerSpeed.debounceTime.description%"
        },
        "liveServerSpeed.openKeybindings": {
          "type": "boolean",
          "default": false,
          "description": "%liveServerSpeed.openKeybindings.description%"
        },
        "liveServerSpeed.bindAddress": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Address used by the local server. Use 0.0.0.0 for access from phones and other devices."
        },
        "liveServerSpeed.serverRoot": {
          "type": "string",
          "default": "",
          "description": "Optional folder to serve instead of the workspace root. Relative paths are resolved from the workspace."
        },
        "liveServerSpeed.entryFile": {
          "type": "string",
          "default": "",
          "description": "Default HTML entry file. Leave empty to detect index.html or a framework build output."
        },
        "liveServerSpeed.openBrowserAutomatically": {
          "type": "boolean",
          "default": false,
          "description": "Open the default browser automatically when the server starts."
        },
        "liveServerSpeed.spaFallback": {
          "type": "boolean",
          "default": true,
          "description": "Serve index.html for extension-less routes used by React, Vue, Angular and other SPAs."
        },
        "liveServerSpeed.usePolling": {
          "type": "boolean",
          "default": false,
          "description": "Use polling for file watching. Enable this only when native file events do not work."
        },
        "liveServerSpeed.ignoredPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional glob patterns ignored by the file watcher."
        },
        "liveServerSpeed.reloadExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Only reload for these file extensions, for example .html, .css and .js. Leave empty for all files."
        },
        "liveServerSpeed.frameworkMode": {
          "type": "string",
          "enum": ["auto", "static"],
          "default": "auto",
          "description": "Framework handling mode. Auto detects Vite, React, Vue, Angular, Svelte, Next and Nuxt projects."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.5.0",
    "@types/open": "^6.1.0",
    "@types/ws": "^8.5.4",
    "mocha": "^11.7.1",
    "typescript": "^5.2.0",
    "vscode": "^1.1.35"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "open": "^10.2.0",
    "selfsigned": "^2.1.1",
    "ws": "^8.13.0"
  }
}
