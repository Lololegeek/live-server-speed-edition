{
  "name": "live-server-speed-edition",
  "displayName": "Live Server Speed Edition",
  "description": "Preview your local web project inside a VS Code WebView or Default Browser with live reload.",
  "version": "1.3.0",
  "keywords": [
    "live server",
    "php",
    "react",
    "typescript",
    "vite",
    "preview",
    "hot reload",
    "web development",
    "vue",
    "svelte"
  ],
  "publisher": "Lololegeek",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lololegeek/live-server-speed-edition"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fast-http-server.toggleServer",
        "title": "Start Fast HTTP Server"
      },
      {
        "command": "fast-http-server.relaunchLast",
        "title": "Relaunch Live Server with Last Parameters"
      },
      {
        "command": "fast-http-server.setShortcut",
        "title": "Set Relaunch Shortcut"
      },
      {
        "command": "fast-http-server.openKeybindings",
        "title": "Open Keyboard Shortcuts for Live Server Speed Edition"
      },
      {
        "command": "fast-http-server.openSettings",
        "title": "Open Extension Settings"
      },
      {
        "command": "fast-http-server.restartServer",
        "title": "Restart Live Server"
      },
      {
        "command": "fast-http-server.showLogs",
        "title": "Show Live Server Logs"
      },
      {
        "command": "fast-http-server.detectProject",
        "title": "Detect Web Project"
      },
      {
        "command": "fast-http-server.openHtmlWithLastParams",
        "title": "%openHtmlWithLastParams%"
      },
      {
        "command": "fast-http-server.openHtmlWithNewParams",
        "title": "%openHtmlWithNewParams%"
      },
      {
        "command": "fast-http-server.instantPreview",
        "title": "Live Server: Instant Preview (unsaved HTML)"
      },
      {
        "command": "fast-http-server.reopenWebview",
        "title": "Live Server: Reopen WebView"
      },
      {
        "command": "fast-http-server.showQr",
        "title": "Live Server: Show QR code"
      },
      {
        "command": "fast-http-server.copyUrl",
        "title": "Live Server: Copy URL"
      },
      {
        "command": "fast-http-server.stopServer",
        "title": "Live Server: Stop"
      },
      {
        "command": "fast-http-server.configureServer",
        "title": "Live Server: Configure Server..."
      },
      {
        "command": "fast-http-server.quickStart",
        "title": "Live Server: Quick Start"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fast-http-server.openHtmlWithLastParams",
          "when": "resourceExtname == .html || resourceExtname == .htm || resourceExtname == .php",
          "group": "2_workspace@1"
        },
        {
          "command": "fast-http-server.openHtmlWithNewParams",
          "when": "resourceExtname == .html || resourceExtname == .htm || resourceExtname == .php",
          "group": "2_workspace@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fast-http-server.toggleServer",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Live Server Speed Edition",
      "properties": {
        "liveServerSpeed.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fr",
            "es",
            "de",
            "it",
            "pt",
            "ja",
            "zh",
            "ko",
            "ru"
          ],
          "default": "auto",
          "description": "%liveServerSpeed.language.description%"
        },
        "liveServerSpeed.debounceTime": {
          "type": "number",
          "default": 50,
          "minimum": 50,
          "maximum": 1000,
          "description": "%liveServerSpeed.debounceTime.description%"
        },
        "liveServerSpeed.serverRoot": {
          "type": "string",
          "default": "",
          "description": "Optional folder to serve instead of the workspace root. Relative paths are resolved from the workspace."
        },
        "liveServerSpeed.entryFile": {
          "type": "string",
          "default": "",
          "description": "Default HTML entry file. Leave empty to detect index.html or a framework build output."
        },
        "liveServerSpeed.spaFallback": {
          "type": "boolean",
          "default": true,
          "description": "Serve index.html for extension-less routes used by React, Vue, Angular and other SPAs."
        },
        "liveServerSpeed.usePolling": {
          "type": "boolean",
          "default": false,
          "description": "Use polling for file watching. Enable this only when native file events do not work."
        },
        "liveServerSpeed.ignoredPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns ignored by the file watcher."
        },
        "liveServerSpeed.reloadExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Only reload for these file extensions, for example .html, .css and .js. Leave empty for all files."
        },
        "liveServerSpeed.frameworkMode": {
          "type": "string",
          "enum": [
            "auto",
            "static"
          ],
          "default": "auto",
          "description": "Framework handling mode. Auto detects Vite, React, Vue, Angular, Svelte, Next and Nuxt projects."
        },
        "liveServerSpeed.port": {
          "type": "number",
          "default": 5500,
          "description": "Public preview port.",
          "minimum": 1,
          "maximum": 65535
        },
        "liveServerSpeed.liveEditing": {
          "type": "boolean",
          "default": true,
          "description": "Reflect unsaved edits. PHP and managed frameworks run in an isolated temporary project copy."
        },
        "liveServerSpeed.phpPath": {
          "type": "string",
          "default": "php",
          "description": "PHP executable installed on your computer."
        },
        "liveServerSpeed.packageManager": {
          "type": "string",
          "default": "npm",
          "description": "Package manager used to launch an existing package.json script.",
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "bun"
          ]
        },
        "liveServerSpeed.upstreamUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5173",
          "description": "URL produced by the development script; this extension does not override framework port flags."
        },
        "liveServerSpeed.headers": {
          "type": "object",
          "default": {},
          "description": "Custom response headers."
        },
        "liveServerSpeed.httpsCertPath": {
          "type": "string",
          "default": "",
          "description": "Optional TLS certificate path. Supply both certificate and key."
        },
        "liveServerSpeed.httpsKeyPath": {
          "type": "string",
          "default": "",
          "description": "Optional TLS private key path."
        },
        "liveServerSpeed.interfaceMode": {
          "type": "string",
          "default": "full",
          "description": "Full setup or Lite one-click launch. Lite displays only the Start/Stop button.",
          "enum": [
            "full",
            "lite"
          ]
        },
        "liveServerSpeed.showStartButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the Start/Stop button. Commands and keyboard shortcuts remain available when hidden."
        },
        "liveServerSpeed.showQrButton": {
          "type": "boolean",
          "default": true,
          "description": "Show QR button while running in Full mode."
        },
        "liveServerSpeed.showReopenButton": {
          "type": "boolean",
          "default": true,
          "description": "Show Reopen WebView button while running in Full mode."
        },
        "liveServerSpeed.showCopyUrlButton": {
          "type": "boolean",
          "default": false,
          "description": "Show Copy URL button while running in Full mode."
        },
        "liveServerSpeed.defaultPreview": {
          "type": "string",
          "default": "browser",
          "description": "Preview destination for the first Lite launch.",
          "enum": [
            "browser",
            "webview"
          ]
        },
        "liveServerSpeed.liteRuntime": {
          "type": "string",
          "default": "auto",
          "description": "Runtime for the first Lite launch; subsequent launches reuse workspace parameters.",
          "enum": [
            "auto",
            "static",
            "php",
            "framework"
          ]
        },
        "liveServerSpeed.requestLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log each HTTP request. Disabled by default to reduce output overhead."
        },
        "liveServerSpeed.nativeHmr": {
          "type": "boolean",
          "default": true,
          "description": "Use framework HMR without a duplicate full-reload watcher. Disable for frameworks without HMR."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/extension.test.cjs test/server.test.cjs",
    "check": "tsc -p . --noEmit",
    "package": "vsce package --no-dependencies",
    "bundle": "npm run compile && esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --external:fsevents --outfile=dist/extension.js",
    "benchmark": "npm run compile && node scripts/benchmark.cjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "1.85.0",
    "@types/ws": "^8.5.4",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.2.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.1.1",
    "ws": "^8.13.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Starting servers and project scripts requires workspace trust."
    },
    "virtualWorkspaces": false
  },
  "license": "MIT"
}
